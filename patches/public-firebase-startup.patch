diff --git a/Sapphire/Utilities/FirebaseConfigurationPolicy.swift b/Sapphire/Utilities/FirebaseConfigurationPolicy.swift
new file mode 100644
index 0000000..4e336e2
--- /dev/null
+++ b/Sapphire/Utilities/FirebaseConfigurationPolicy.swift
@@ -0,0 +1,16 @@
+import Foundation
+
+enum FirebaseConfigurationPolicy {
+    static func canConfigureFirebase(optionsAt url: URL?) -> Bool {
+        guard let url,
+              let data = try? Data(contentsOf: url),
+              let options = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],
+              let apiKey = options["API_KEY"] as? String,
+              !apiKey.isEmpty,
+              let appID = options["GOOGLE_APP_ID"] as? String,
+              !appID.isEmpty else {
+            return false
+        }
+        return true
+    }
+}
